# Freyja-OS environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

FREYJA_ENV=development
FREYJA_HOST=127.0.0.1
FREYJA_PORT=8000
# Required in production for connector/operator endpoints beyond / and /health.
FREYJA_CONNECTOR_TOKEN=

OLLAMA_BASE_URL=http://127.0.0.1:11434
# Minimum-capability conversational model.  Sub-3B models are reserved for
# classification and routing only.
OLLAMA_MODEL=qwen2.5:7b
# Minimum-capability model used for full conversational responses.
OLLAMA_CHAT_MODEL=qwen2.5:7b
# Lightweight model reserved for classification, routing, and extraction.
OLLAMA_CLASSIFICATION_MODEL=qwen2.5:1.5b
# Models smaller than this (in billions of parameters) are blocked from chat.
OLLAMA_MIN_CHAT_PARAMETERS_B=3
# Keep the active Ollama model loaded after a request to reduce warm-response latency.
# Examples: 30m, 2h, -1. Higher values reserve more RAM/VRAM.
OLLAMA_KEEP_ALIVE=30m
OLLAMA_WARMUP_ENABLED=true
# Blank warms OLLAMA_CHAT_MODEL and INFERENCE_GATEWAY_LOCAL_MODEL. Override with
# a comma-separated list if Iris/Hera should keep specific models loaded.
OLLAMA_WARMUP_MODELS=
OLLAMA_WARMUP_INTERVAL_SECONDS=1200
OLLAMA_WARMUP_TIMEOUT_SECONDS=90

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Live-data weather tool uses Open-Meteo and does not require an API key.
WEATHER_TOOL_ENABLED=true

# Authenticated native Apple Calendar bridge hosted on Iris.
APPLE_CALENDAR_BRIDGE_URL=
APPLE_CALENDAR_BRIDGE_TOKEN=
APPLE_CALENDAR_BRIDGE_TIMEOUT_SECONDS=15

# Authenticated native Apple Reminders bridge hosted on Iris.
APPLE_REMINDERS_BRIDGE_URL=
APPLE_REMINDERS_BRIDGE_TOKEN=
APPLE_REMINDERS_BRIDGE_TIMEOUT_SECONDS=15

# Cloud routing policy
CLOUD_ENABLED=true
OPENROUTER_MONTHLY_SOFT_LIMIT=20.0
OPENROUTER_MONTHLY_HARD_LIMIT=30.0
OPENROUTER_PER_REQUEST_LIMIT=1.0
LOCAL_MAX_PROMPT_CHARS=8000
OPENROUTER_ALLOWLIST=openai/gpt-4o-mini,anthropic/claude-3.5-haiku

# Mars inference gateway. Keep disabled until the Mars container is deployed and
# telemetry/audit paths are verified.
INFERENCE_GATEWAY_ENABLED=false
INFERENCE_GATEWAY_MONTHLY_HARD_LIMIT=20.0
INFERENCE_GATEWAY_PER_REQUEST_LIMIT=1.0
# Cloyd-parity default for tool/hard agent work. Routine no-tool chat stays local first.
INFERENCE_GATEWAY_DEFAULT_TIER=DEEP
INFERENCE_GATEWAY_LOCAL_MODEL=qwen2.5:7b
# Opportunistic only: set this to a currently verified OpenRouter :free model.
INFERENCE_GATEWAY_FREE_MODEL=
INFERENCE_GATEWAY_FAST_MODEL=qwen/qwen3.5-flash-02-23
INFERENCE_GATEWAY_REASONING_MODEL=moonshotai/kimi-k2.5
INFERENCE_GATEWAY_DEEP_MODEL=z-ai/glm-5
INFERENCE_GATEWAY_FRONTIER_MODEL=openai/gpt-5.4
INFERENCE_GATEWAY_OPENROUTER_ALLOWLIST=qwen/qwen3.5-flash-02-23,moonshotai/kimi-k2.5,z-ai/glm-5,openai/gpt-5.4
INFERENCE_GATEWAY_OLLAMA_CLOUD_BASE_URL=
INFERENCE_GATEWAY_OLLAMA_CLOUD_API_KEY=
INFERENCE_GATEWAY_OLLAMA_CLOUD_MODEL=

# Conversation memory
MEMORY_ENABLED=true
MEMORY_DATABASE_PATH=/Users/freyja/freyja-os/data/freyja.db
MEMORY_MAX_MESSAGES_PER_CONVERSATION=1000
MEMORY_RETENTION_DAYS=90

# Canonical identity source. Runtime databases belong outside the repository.
IDENTITY_PROVIDER=seeded
IDENTITY_DATABASE_PATH=/Users/freyja/.local/state/freyja/identity.sqlite3
IDENTITY_SEED_FALLBACK=true

# Tool registry
TOOLS_ENABLED=true
TOOLS_DEFAULT_TIMEOUT_SECONDS=30
TOOLS_AUDIT_LOG_ENABLED=true

# Home Assistant API (private network only; token stays outside Git)
HOME_ASSISTANT_BASE_URL=http://127.0.0.1:8123
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_TIMEOUT_SECONDS=10
HOME_ASSISTANT_ENTITY_ALLOWLIST=

# Telegram gateway (disabled by default)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_PERSON_USER_ID=
TELEGRAM_DIRECT_MESSAGES_ONLY=true
TELEGRAM_SMITH_READ_ONLY_ENABLED=false

# Optional second personal-agent bot. Allowed IDs may include onboarding users,
# but only the explicitly mapped person ID receives trusted person context.
TELEGRAM_BENEDICT_ENABLED=false
TELEGRAM_BENEDICT_BOT_TOKEN=
TELEGRAM_BENEDICT_ALLOWED_USER_IDS=
TELEGRAM_BENEDICT_PERSON_USER_ID=
TELEGRAM_BENEDICT_TOOLS_ENABLED=false
TELEGRAM_BENEDICT_STATE_DIR=
TELEGRAM_BENEDICT_MODEL=benedict-qwen2.5:7b

# Signal gateway and signal-cli-rest-api transport (disabled by default)
SIGNAL_ENABLED=false
SIGNAL_ACCOUNT_NUMBER=
SIGNAL_ALLOWED_SENDERS=
SIGNAL_REST_API_URL=http://127.0.0.1:8080
SIGNAL_POLL_INTERVAL_SECONDS=5
SIGNAL_TRANSPORT_TIMEOUT_SECONDS=60
SIGNAL_REQUEST_TIMEOUT_SECONDS=30
SIGNAL_RECONNECT_MAX_SECONDS=60
SIGNAL_MAX_MESSAGE_CHARS=4000
