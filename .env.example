# Freyja-OS environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

FREYJA_ENV=development
FREYJA_HOST=127.0.0.1
FREYJA_PORT=8000

OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional Odin/heavy local reasoning endpoint. Leave blank to use
# OLLAMA_BASE_URL until Vulcan is online.
OLLAMA_REASONING_BASE_URL=
# Minimum-capability conversational model.  Sub-3B models are reserved for
# classification and routing only.
OLLAMA_MODEL=qwen2.5:7b
# Minimum-capability model used for full conversational responses.
OLLAMA_CHAT_MODEL=qwen2.5:7b
# Lightweight model reserved for classification, routing, and extraction.
OLLAMA_CLASSIFICATION_MODEL=qwen2.5:1.5b
# Heavy local reasoning model expected on Odin.
OLLAMA_REASONING_MODEL=gpt-oss-freyja:20b-analysis-prefill
# Deterministic local coding model used by the Agent Smith/Qwen coding lane.
OLLAMA_CODING_MODEL=qwen2.5-coder:14b-q3
# Models smaller than this (in billions of parameters) are blocked from chat.
OLLAMA_MIN_CHAT_PARAMETERS_B=3

# Rev 2 Iris fast path. Keep disabled until Atlas can reach Iris over the
# private network and the shadow-routing smoke test passes.
IRIS_ROUTER_ENABLED=false
# Active advisory lets Iris influence routing only after confidence and
# Director policy checks pass. Leave false until shadow data is reviewed.
IRIS_ROUTER_ADVISORY_ENABLED=false
IRIS_ROUTER_SHADOW_ENABLED=false
IRIS_OLLAMA_BASE_URL=http://iris:11434
IRIS_ROUTER_MODEL=qwen2.5:7b
IRIS_ROUTER_TIMEOUT_SECONDS=4.0
IRIS_ROUTER_CONFIDENCE_THRESHOLD=0.80
# Any negative Ollama keep_alive value requests indefinite model residency.
IRIS_ROUTER_KEEP_ALIVE=-1
IRIS_ROUTER_MAX_PROMPT_CHARS=12000
IRIS_ROUTER_WARM_ENABLED=true
IRIS_ROUTER_WARM_INTERVAL_SECONDS=600
IRIS_ROUTER_MIN_AVAILABLE_MEMORY_MB=8192

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Live-data weather tool (disabled until reviewed; no API key required for Open-Meteo)
WEATHER_TOOL_ENABLED=false

# Cloud routing policy
CLOUD_ENABLED=true
OPENROUTER_MONTHLY_SOFT_LIMIT=20.0
OPENROUTER_MONTHLY_HARD_LIMIT=30.0
OPENROUTER_PER_REQUEST_LIMIT=1.0
LOCAL_MAX_PROMPT_CHARS=8000
OPENROUTER_ALLOWLIST=openai/gpt-4o-mini,anthropic/claude-3.5-haiku

# Optional Rev 2 provider profile overrides. JSON must be a list of strict
# profile objects; invalid entries are ignored and legacy defaults remain.
# FREYJA_INFERENCE_PROVIDER_PROFILES=[{"provider_id":"heavy_local","kind":"ollama","base_url":"http://vulcan:11434","model":"gpt-oss-freyja:20b-analysis-prefill","capabilities":["chat","reasoning","coding"],"locality":"local_heavy","tier":3,"priority":30,"enabled":true}]

# Conversation memory
MEMORY_ENABLED=true
MEMORY_DATABASE_PATH=/Users/freyja/freyja-os/data/freyja.db
MEMORY_MAX_MESSAGES_PER_CONVERSATION=1000
MEMORY_RETENTION_DAYS=90

# Canonical identity source. Runtime databases belong outside the repository.
IDENTITY_PROVIDER=seeded
IDENTITY_DATABASE_PATH=/Users/freyja/.local/state/freyja/identity.sqlite3
IDENTITY_SEED_FALLBACK=true

# Tool registry
TOOLS_ENABLED=true
TOOLS_DEFAULT_TIMEOUT_SECONDS=30
TOOLS_AUDIT_LOG_ENABLED=true

# Family Calendar provider. Keep memory in CI/dev; set default to apple on Iris
# after macOS Calendar is signed into Freyja's Apple identity and has a Family
# calendar available through EventKit.
CALENDAR_DEFAULT_PROVIDER=memory
APPLE_CALENDAR_ENABLED=false
APPLE_CALENDAR_BACKEND=swift
APPLE_CALENDAR_DEFAULT_CALENDAR_NAME=iCloud::Family
APPLE_CALENDAR_CALENDAR_ALIASES=joe=iCloud::Family,beth=iCloud::Family,family=iCloud::Family
APPLE_CALENDAR_TIMEOUT_SECONDS=9.0

# Iris MacAgent internal API. Local network origin is not authorization; set a
# strong token on both Atlas and Iris before enabling.
MACAGENT_ENABLED=false
MACAGENT_BASE_URL=http://iris:8765
MACAGENT_TOKEN=
MACAGENT_TIMEOUT_SECONDS=5.0
MACAGENT_HOST=127.0.0.1
MACAGENT_PORT=8765

# Home Assistant household boundary. Leave base URL/token empty to use fixtures.
HOME_ASSISTANT_BASE_URL=
HOME_ASSISTANT_ACCESS_TOKEN=
HOME_ASSISTANT_LOCATION_NAME=Atlanta
HOME_ASSISTANT_ALLOWED_CONTROL_DOMAINS=light
HOME_ASSISTANT_STATE_FIXTURE={"light.downstairs":"on"}
HOME_ASSISTANT_INVENTORY_SNAPSHOT_PATH=/Users/freyja/.local/state/freyja/home-assistant-inventory.json
HOME_ASSISTANT_INVENTORY_POLL_ENABLED=true
HOME_ASSISTANT_INVENTORY_POLL_INTERVAL_SECONDS=600

# Telegram gateway (disabled by default)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_PERSON_USER_ID=
TELEGRAM_DIRECT_MESSAGES_ONLY=true
TELEGRAM_SMITH_READ_ONLY_ENABLED=false

# Optional second personal-agent bot. Allowed IDs may include onboarding users,
# but only the explicitly mapped person ID receives trusted person context.
TELEGRAM_BENEDICT_ENABLED=false
TELEGRAM_BENEDICT_BOT_TOKEN=
TELEGRAM_BENEDICT_ALLOWED_USER_IDS=
TELEGRAM_BENEDICT_PERSON_USER_ID=
TELEGRAM_BENEDICT_TOOLS_ENABLED=false
TELEGRAM_BENEDICT_STATE_DIR=
TELEGRAM_BENEDICT_MODEL=benedict-qwen2.5:7b

# Signal gateway and signal-cli-rest-api transport on Atlas (disabled by default)
SIGNAL_ENABLED=false
SIGNAL_ACCOUNT_NUMBER=
# Alias approved senders to protected agent scopes:
# family=<number> -> Freyja, joe=<number> -> Cloyd Gibbler, beth=<number> -> Benedict.
SIGNAL_ALLOWED_SENDERS=
SIGNAL_REST_API_URL=http://127.0.0.1:8080
SIGNAL_POLL_INTERVAL_SECONDS=5
SIGNAL_TRANSPORT_TIMEOUT_SECONDS=60
SIGNAL_REQUEST_TIMEOUT_SECONDS=30
SIGNAL_RECONNECT_MAX_SECONDS=60
SIGNAL_MAX_MESSAGE_CHARS=4000

# Native iMessage gateway on Iris (disabled by default)
IMESSAGE_ENABLED=false
IMESSAGE_IMSG_PATH=
IMESSAGE_DATABASE_PATH=/Users/freyja/Library/Messages/chat.db
# Alias approved senders to protected family scopes, for example:
# family=family@example.com,joe=joe@example.com,beth=beth@example.com
IMESSAGE_ALLOWED_SENDERS=
IMESSAGE_MAX_MESSAGE_CHARS=4000
IMESSAGE_TOOLS_REQUIRED_MODE=always
IMESSAGE_REQUEST_TIMEOUT_SECONDS=120
IMESSAGE_COMMAND_TIMEOUT_SECONDS=10
IMESSAGE_SEND_TIMEOUT_SECONDS=30
IMESSAGE_WATCH_ENABLED=true
IMESSAGE_POLL_DATABASE_ENABLED=true
IMESSAGE_POLL_INTERVAL_SECONDS=5
IMESSAGE_POLL_CHAT_LIMIT=10
IMESSAGE_POLL_HISTORY_LIMIT=3

# Gmail work gateway (disabled by default)
GMAIL_ENABLED=false
GMAIL_IDENTITY=
# Alias approved senders to protected family scopes, for example:
# family=person@example.com,joe=joe.work@example.com
GMAIL_ALLOWED_SENDERS=
GMAIL_MAX_MESSAGE_CHARS=12000
GMAIL_REQUEST_TIMEOUT_SECONDS=120
GMAIL_POLL_INTERVAL_SECONDS=10
GMAIL_RECONNECT_MAX_SECONDS=60
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_MAILBOX=INBOX
GMAIL_IMAP_USERNAME=
GMAIL_IMAP_PASSWORD=
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_PASSWORD=
GMAIL_SMTP_FROM_NAME=Freyja
GMAIL_SMTP_STARTTLS=true

# Family iMessage passive observer on Iris (disabled by default)
IMESSAGE_FAMILY_OBSERVER_ENABLED=false
# Comma-separated iMessage chat identifiers for authorized family groups.
IMESSAGE_FAMILY_CHAT_IDENTIFIERS=
IMESSAGE_FAMILY_INVOCATION_NAMES=freyja,@freyja
IMESSAGE_FAMILY_MEMORY_ENABLED=true
IMESSAGE_PROVISIONAL_REPLY_ENABLED=false
IMESSAGE_PROVISIONAL_REPLY_DELAY_SECONDS=2.0
IMESSAGE_PROVISIONAL_REPLY_TEXT=Working on it...
