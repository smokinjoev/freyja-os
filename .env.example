# Freyja-OS environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

FREYJA_ENV=development
FREYJA_HOST=127.0.0.1
FREYJA_PORT=8000

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

OPENROUTER_API_KEY=sk-or-v1-000000000000000000000000000000000000000000000000
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Cloud routing policy
CLOUD_ENABLED=true
OPENROUTER_MONTHLY_SOFT_LIMIT=20.0
OPENROUTER_MONTHLY_HARD_LIMIT=30.0
OPENROUTER_PER_REQUEST_LIMIT=1.0
LOCAL_MAX_PROMPT_CHARS=8000
OPENROUTER_ALLOWLIST=openai/gpt-4o-mini,anthropic/claude-3.5-haiku

# Conversation memory
MEMORY_ENABLED=true
MEMORY_DATABASE_PATH=/Users/freyja/freyja-os/data/freyja.db
MEMORY_MAX_MESSAGES_PER_CONVERSATION=1000
MEMORY_RETENTION_DAYS=90

# Tool registry
TOOLS_ENABLED=true
TOOLS_DEFAULT_TIMEOUT_SECONDS=30
TOOLS_AUDIT_LOG_ENABLED=true

# Telegram gateway (disabled by default)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_DIRECT_MESSAGES_ONLY=true
TELEGRAM_SMITH_READ_ONLY_ENABLED=false
