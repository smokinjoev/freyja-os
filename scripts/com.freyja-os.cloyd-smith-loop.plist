<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.freyja-os.cloyd-smith-loop</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/freyja/freyja-os/.venv/bin/python</string>
        <string>/Users/freyja/freyja-os/scripts/cloyd-smith-loop-daemon.py</string>
        <string>--interval</string>
        <string>15</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/freyja</string>
        <key>USER</key>
        <string>freyja</string>
        <key>LOGNAME</key>
        <string>freyja</string>
        <key>PYTHONPATH</key>
        <string>/Users/freyja/freyja-os/src:/Users/freyja/freyja-os</string>
        <key>PATH</key>
        <string>/Users/freyja/freyja-os/.venv/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>CLOYD_SMITH_LOOP_DATABASE_PATH</key>
        <string>/Users/freyja/.local/state/freyja/cloyd-smith-loop.db</string>
        <key>OPENCODE_REQUEST_TIMEOUT_SECONDS</key>
        <string>90</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/freyja/freyja-os</string>

    <key>StandardOutPath</key>
    <string>/Users/freyja/freyja-os/logs/cloyd-smith-loop.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/freyja/freyja-os/logs/cloyd-smith-loop.log</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
