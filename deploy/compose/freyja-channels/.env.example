# Freyja Open WebUI channel gateway configuration for Atlas.
# Copy to .env, chmod 600, and keep it out of git.

OPEN_WEBUI_URL=http://100.119.235.114:3001
OPEN_WEBUI_API_KEY=
OPEN_WEBUI_API_KEY_FILE=/run/secrets/open_webui_api_key
FREYJA_CHANNEL_OPEN_WEBUI_TIMEOUT=120

# Telegram pilot for Joe. Leave disabled until token, allowlist, and identity map are reviewed.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_IDENTITY_MAP=
FREYJA_CHANNEL_TELEGRAM_POLL_INTERVAL=2

# Signal path using signal-cli-rest-api. Leave disabled until registration/linking is complete.
SIGNAL_ENABLED=false
SIGNAL_ACCOUNT_NUMBER=
SIGNAL_REST_API_URL=http://signal-api:8080
SIGNAL_ALLOWED_SENDERS=
SIGNAL_IDENTITY_MAP=
FREYJA_CHANNEL_SIGNAL_POLL_INTERVAL=5
