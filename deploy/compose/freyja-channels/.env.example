# Freyja Open WebUI channel gateway configuration for Atlas.
# Copy to .env, chmod 600, and keep it out of git.

OPEN_WEBUI_URL=http://100.119.235.114:3001
OPEN_WEBUI_API_KEY=
OPEN_WEBUI_API_KEY_FILE=/run/secrets/open_webui_api_key
FREYJA_CHANNEL_OPEN_WEBUI_TIMEOUT=120
FREYJA_CHANNELS_UID=1000
FREYJA_CHANNELS_GID=1000
FREYJA_CHANNEL_STATE_DIR=../../../data/freyja-channels

# Telegram pilot for Joe. Leave disabled until token, allowlist, and identity map are reviewed.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_IDENTITY_MAP=
TELEGRAM_BOT_PROFILES=FREYJA_JOE,CLOYD_JOE,BENEDICT_BETH,AGENT44_LIAM,JENNA
TELEGRAM_FREYJA_JOE_BOT_TOKEN=
TELEGRAM_FREYJA_JOE_ALLOWED_USER_IDS=
TELEGRAM_FREYJA_JOE_IDENTITY_MAP=
TELEGRAM_FREYJA_JOE_AGENT=freyja
TELEGRAM_CLOYD_JOE_BOT_TOKEN=
TELEGRAM_CLOYD_JOE_ALLOWED_USER_IDS=
TELEGRAM_CLOYD_JOE_IDENTITY_MAP=
TELEGRAM_CLOYD_JOE_AGENT=cloyd
TELEGRAM_BENEDICT_BETH_BOT_TOKEN=
TELEGRAM_BENEDICT_BETH_ALLOWED_USER_IDS=
TELEGRAM_BENEDICT_BETH_IDENTITY_MAP=
TELEGRAM_BENEDICT_BETH_AGENT=benedict
TELEGRAM_AGENT44_LIAM_BOT_TOKEN=
TELEGRAM_AGENT44_LIAM_ALLOWED_USER_IDS=
TELEGRAM_AGENT44_LIAM_IDENTITY_MAP=
TELEGRAM_AGENT44_LIAM_AGENT=agent-44
TELEGRAM_JENNA_BOT_TOKEN=
TELEGRAM_JENNA_ALLOWED_USER_IDS=
TELEGRAM_JENNA_IDENTITY_MAP=
TELEGRAM_JENNA_AGENT=jenna
FREYJA_CHANNEL_TELEGRAM_POLL_INTERVAL=2
TELEGRAM_MAX_ATTACHMENT_BYTES=8388608

# Signal path using signal-cli-rest-api. Leave disabled until registration/linking is complete.
SIGNAL_ENABLED=false
SIGNAL_ACCOUNT_NUMBER=
SIGNAL_REST_API_URL=http://signal-api:8080
SIGNAL_PRIVATE_NETWORK=freyja-signal-atlas_signal-private
SIGNAL_ALLOWED_SENDERS=
SIGNAL_IDENTITY_MAP=
FREYJA_CHANNEL_SIGNAL_POLL_INTERVAL=5
