# Atlas Director/control-plane configuration.
# Copy to .env in this directory, replace local values, and chmod 600 the file.
# Never commit the populated .env file.

FREYJA_ENV=production

# Bind the published Director port to Atlas's private Tailscale address or host
# name. Do not commit populated private addresses.
FREYJA_DIRECTOR_BIND_IP=<atlas-tailscale-address>
FREYJA_CONNECTOR_TOKEN=

# Existing execution provider. During Rev 2 migration this remains the provider
# used by current Director behavior while Iris observes in shadow mode.
OLLAMA_BASE_URL=http://<current-ollama-host>:11434
# Odin heavy local reasoning endpoint. Leave blank or match OLLAMA_BASE_URL
# until Odin is installed and reachable over the private tailnet.
OLLAMA_REASONING_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_CLASSIFICATION_MODEL=qwen2.5:1.5b
OLLAMA_REASONING_MODEL=gpt-oss:20b
OLLAMA_DEFAULT_OUTPUT_TOKENS=512
OLLAMA_MIN_OUTPUT_TOKENS=160
OLLAMA_RETRY_OUTPUT_TOKENS=1024
OLLAMA_MIN_CHAT_PARAMETERS_B=3

# Iris fast-path router. Use Iris's private Tailscale name/address in the
# untracked deployment .env. Shadow mode records recommendations only; it does
# not select providers, authorize tools, or alter responses.
IRIS_ROUTER_ENABLED=true
IRIS_ROUTER_SHADOW_ENABLED=true
IRIS_OLLAMA_BASE_URL=http://<iris-tailscale-host>:11434
IRIS_ROUTER_MODEL=qwen2.5:7b
IRIS_ROUTER_TIMEOUT_SECONDS=4.0
IRIS_ROUTER_KEEP_ALIVE=-1
IRIS_ROUTER_MAX_PROMPT_CHARS=12000

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
CLOUD_ENABLED=true
OPENROUTER_MONTHLY_SOFT_LIMIT=20.0
OPENROUTER_MONTHLY_HARD_LIMIT=30.0
OPENROUTER_PER_REQUEST_LIMIT=1.0
LOCAL_MAX_PROMPT_CHARS=8000
OPENROUTER_ALLOWLIST=openai/gpt-4o-mini,anthropic/claude-3.5-haiku

MEMORY_ENABLED=true
MEMORY_MAX_MESSAGES_PER_CONVERSATION=1000
MEMORY_RETENTION_DAYS=90
MEMORY_SHARED_ENABLED=true
MEMORY_SHARED_MAX_ITEMS_PER_PRINCIPAL=200
MEMORY_SHARED_MAX_GLOBAL_ITEMS=10000
MEMORY_SHARED_MAX_ITEM_CHARS=2000
MEMORY_RECALL_MAX_ITEMS=12
MEMORY_RECALL_MAX_ITEM_CHARS=500
MEMORY_RECALL_MAX_TOTAL_CHARS=3000
MEMORY_RECALL_INCLUDE_IN_CLOUD=false
TOOLS_ENABLED=true
TOOLS_DEFAULT_TIMEOUT_SECONDS=30
TOOLS_AUDIT_LOG_ENABLED=true
WEATHER_TOOL_ENABLED=false
