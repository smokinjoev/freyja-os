# Mars Director/control-plane configuration.
# Copy to .env in this directory, replace local values, and chmod 600 the file.
# Never commit the populated .env file.

FREYJA_ENV=production

# Bind the published Director port to Mars's private Tailscale address or host
# name so Atlas can connect without exposing the Director on every host
# interface. Do not commit populated private addresses.
FREYJA_DIRECTOR_BIND_IP=<mars-tailscale-address>
FREYJA_CONNECTOR_TOKEN=

# Hera currently provides the primary complex local_reasoning model over
# Tailscale. Iris remains the fast local inference tier. Use private tailnet
# names or addresses in the untracked deployment .env, not in this example.
OLLAMA_BASE_URL=http://<hera-tailscale-host>:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_CLASSIFICATION_MODEL=qwen2.5:1.5b
OLLAMA_REASONING_MODEL=gpt-oss:20b
OLLAMA_DEFAULT_OUTPUT_TOKENS=512
OLLAMA_MIN_OUTPUT_TOKENS=160
OLLAMA_RETRY_OUTPUT_TOKENS=1024
OLLAMA_MIN_CHAT_PARAMETERS_B=3

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
CLOUD_ENABLED=true
OPENROUTER_MONTHLY_SOFT_LIMIT=20.0
OPENROUTER_MONTHLY_HARD_LIMIT=30.0
OPENROUTER_PER_REQUEST_LIMIT=1.0
LOCAL_MAX_PROMPT_CHARS=8000
OPENROUTER_ALLOWLIST=openai/gpt-4o-mini,anthropic/claude-3.5-haiku

MEMORY_ENABLED=true
MEMORY_MAX_MESSAGES_PER_CONVERSATION=1000
MEMORY_RETENTION_DAYS=90
MEMORY_SHARED_ENABLED=true
MEMORY_SHARED_MAX_ITEMS_PER_PRINCIPAL=200
MEMORY_SHARED_MAX_GLOBAL_ITEMS=10000
MEMORY_SHARED_MAX_ITEM_CHARS=2000
MEMORY_RECALL_MAX_ITEMS=12
MEMORY_RECALL_MAX_ITEM_CHARS=500
MEMORY_RECALL_MAX_TOTAL_CHARS=3000
MEMORY_RECALL_INCLUDE_IN_CLOUD=false
TOOLS_ENABLED=true
TOOLS_DEFAULT_TIMEOUT_SECONDS=30
TOOLS_AUDIT_LOG_ENABLED=true
WEATHER_TOOL_ENABLED=false
