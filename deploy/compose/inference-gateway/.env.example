FREYJA_ENV=production
FREYJA_CONNECTOR_TOKEN=
FREYJA_INFERENCE_GATEWAY_BIND_IP=127.0.0.1

OLLAMA_BASE_URL=http://<hera-tailscale-host>:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_CHAT_MODEL=qwen3:14b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_WARMUP_ENABLED=true
OLLAMA_WARMUP_MODELS=qwen3:14b
OLLAMA_WARMUP_INTERVAL_SECONDS=1200
OLLAMA_WARMUP_TIMEOUT_SECONDS=90

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CLOUD_ENABLED=true

INFERENCE_GATEWAY_ENABLED=true
INFERENCE_GATEWAY_MONTHLY_HARD_LIMIT=20.0
INFERENCE_GATEWAY_PER_REQUEST_LIMIT=1.0
# Cloyd-parity default: local first, cloud only for fallback/escalation.
INFERENCE_GATEWAY_DEFAULT_TIER=LOCAL
INFERENCE_GATEWAY_LOCAL_MODEL=qwen3:14b
INFERENCE_GATEWAY_FREE_MODEL=
INFERENCE_GATEWAY_FAST_MODEL=qwen/qwen3.5-flash-02-23
INFERENCE_GATEWAY_REASONING_MODEL=moonshotai/kimi-k2.5
INFERENCE_GATEWAY_DEEP_MODEL=z-ai/glm-5
INFERENCE_GATEWAY_FRONTIER_MODEL=openai/gpt-5.4
INFERENCE_GATEWAY_OPENROUTER_ALLOWLIST=qwen/qwen3.5-flash-02-23,moonshotai/kimi-k2.5,z-ai/glm-5,openai/gpt-5.4
INFERENCE_GATEWAY_OLLAMA_CLOUD_BASE_URL=
INFERENCE_GATEWAY_OLLAMA_CLOUD_API_KEY=
INFERENCE_GATEWAY_OLLAMA_CLOUD_MODEL=
