# Atlas Signal connector configuration.
# Copy to .env in this directory and replace local values.
# Never commit the populated .env file.

# Atlas hosts the Freyja Director/control plane. If this stack runs on the
# same Atlas host as Director, the private Docker host gateway or Atlas's
# private Tailscale endpoint may be used; do not publish Signal to test it.
FREYJA_DIRECTOR_URL=http://<atlas-director-private-host>:8000
FREYJA_CONNECTOR_TOKEN=

# Signal remains disabled until an existing account is linked or registered
# deliberately and the E.164 values below have been reviewed.
SIGNAL_ENABLED=false
SIGNAL_ACCOUNT_NUMBER=
SIGNAL_ALLOWED_SENDERS=

SIGNAL_POLL_INTERVAL_SECONDS=5
SIGNAL_TRANSPORT_TIMEOUT_SECONDS=60
SIGNAL_REQUEST_TIMEOUT_SECONDS=30
SIGNAL_RECONNECT_MAX_SECONDS=60
SIGNAL_MAX_MESSAGE_CHARS=4000

# Pin deliberately when upgrading the REST wrapper.
SIGNAL_REST_API_IMAGE=bbernhard/signal-cli-rest-api:0.100
