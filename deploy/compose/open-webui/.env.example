# Atlas Open WebUI configuration.
#
# Bind to Atlas's private Tailscale address for LAN/tailnet-only access, or
# leave 0.0.0.0 for a local test behind host firewall rules.
OPEN_WEBUI_BIND_IP=0.0.0.0
OPEN_WEBUI_HOST_PORT=3001

# Persist this key across container recreates so sessions remain valid.
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=replace-with-random-hex

# Initial provider: Vulcan's OpenAI-compatible endpoint over Tailscale.
# Freyja remains the Atlas control plane, but main Freyja Director does not
# currently expose /v1/models directly for Open WebUI.
# Open WebUI talks to the local model-proxy, which exposes the approved model
# catalog and enforces one resident Vulcan model at a time.
OPENAI_API_BASE_URL=http://model-proxy:8080/v1
OPENAI_API_KEY=not-needed
DEFAULT_MODELS=qwen2.5vl:72b
OPEN_WEBUI_APPROVED_MODELS=qwen2.5:32b-instruct,qwen2.5vl:72b,qwen3:30b-a3b,qwen3-coder-next:q4_K_M,gpt-oss:20b,gpt-oss-freyja:20b-analysis-prefill,gpt-oss:120b
OPEN_WEBUI_FALLBACK_MODELS=qwen2.5:7b
OPENAI_PRIMARY_BASE_URL=http://100.94.80.21:8088/v1
OPENAI_PRIMARY_API_KEY=not-needed
OPENAI_PRIMARY_OLLAMA_BASE_URL=http://100.94.80.21:11434
OPENAI_FALLBACK_BASE_URL=http://100.115.228.56:11434/v1
OPENAI_FALLBACK_API_KEY=not-needed
OPEN_WEBUI_PROBE_MODELS=gpt-oss:120b
OPEN_WEBUI_PROBE_TIMEOUT_SECONDS=45
OPEN_WEBUI_VISION_MODELS=qwen2.5vl:72b
OPEN_WEBUI_TEXT_MODEL=qwen2.5vl:72b
OPEN_WEBUI_TOOL_MODEL=qwen2.5:32b-instruct

# Long-running local models can spend minutes generating or reasoning.
AIOHTTP_CLIENT_TIMEOUT=1800
AIOHTTP_CLIENT_TIMEOUT_MODEL_LIST=15
AIOHTTP_CLIENT_TIMEOUT_OPENAI_MODEL_LIST=15

# Keep sign-in enabled by default for a shared household UI.
WEBUI_AUTH=true
