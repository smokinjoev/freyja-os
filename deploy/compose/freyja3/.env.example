FREYJA_ENV=production
FREYJA_CONNECTOR_TOKEN=

# Keep inference disabled until a host-specific smoke test has confirmed
# remote Vulcan latency and model availability for this service.
FREYJA3_INFERENCE_ENABLED=false
FREYJA3_MEMORY_DATABASE_PATH=/app/data/freyja3_memory.db
FREYJA3_SCHEDULER_DATABASE_PATH=/app/data/freyja3_scheduler.db
FREYJA3_MACHINE_DATABASE_PATH=/app/data/freyja3_machines.db
FREYJA3_WORKER_DATABASE_PATH=/app/data/freyja3_workers.db
FREYJA3_AUDIT_DATABASE_PATH=/app/data/freyja3_audit.db

FREYJA3_BIND_IP=0.0.0.0
FREYJA3_HOST_PORT=8300

LITELLM_BIND_IP=0.0.0.0
LITELLM_HOST_PORT=4000
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-freyja-litellm-local
LITELLM_LOG=INFO
NEXUS_BASE_URL=http://100.94.80.21:3939
NEXUS_API_KEY=
IRIS_OLLAMA_BASE_URL=http://100.115.228.56:11434
VULCAN_OLLAMA_BASE_URL=http://100.94.80.21:11434
VULCAN_OPENAI_BASE_URL=http://100.94.80.21:1234/v1
VULCAN_OPENAI_API_KEY=not-needed
OPENROUTER_API_KEY=

OLLAMA_BASE_URL=http://100.94.80.21:11434
OLLAMA_REASONING_BASE_URL=http://100.94.80.21:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_REASONING_MODEL=qwen2.5:32b-instruct
OLLAMA_CODING_MODEL=qwen3-coder-next:q4_K_M
OLLAMA_VISION_MODEL=qwen2.5vl:72b
# Optional Freyja-native compute entries for LM Studio, llama.cpp, or other
# OpenAI-compatible local servers. Example:
# FREYJA3_INFERENCE_ENDPOINTS='[{"endpoint_id":"vulcan-lmstudio","display_name":"Vulcan LM Studio","provider":"lmstudio","machine_id":"vulcan","base_url":"http://100.94.80.21:1234","model":"local-model","capabilities":["general.large","chat"],"security_domain_id":"household","priority":20}]'
# LiteLLM compose example:
# FREYJA3_INFERENCE_ENDPOINTS='[{"endpoint_id":"vulcan-general-litellm","display_name":"Vulcan General LiteLLM Gateway","provider":"openai-compatible","machine_id":"vulcan","base_url":"http://litellm:4000","model":"vulcan-general","capabilities":["general.large","chat"],"security_domain_id":"household","priority":15},{"endpoint_id":"vulcan-deep-litellm","display_name":"Vulcan Deep LiteLLM Gateway","provider":"openai-compatible","machine_id":"vulcan","base_url":"http://litellm:4000","model":"vulcan-deep","capabilities":["general.deep","reasoning.deep","long_context"],"security_domain_id":"household","priority":30}]'
# Nexus compose example. Enable only after Msty Nexus is installed on Vulcan,
# listening on Tailscale/LAN, and a local Nexus client token is stored outside
# git in NEXUS_API_KEY:
# FREYJA3_INFERENCE_ENDPOINTS='[{"endpoint_id":"vulcan-nexus-fast","display_name":"Vulcan Nexus fast local preset","provider":"nexus","machine_id":"vulcan","base_url":"http://100.94.80.21:3939","model":"@preset/freyja-fast-local","capabilities":["general.local","chat"],"security_domain_id":"household","priority":12},{"endpoint_id":"vulcan-nexus-strong","display_name":"Vulcan Nexus strong local preset","provider":"nexus","machine_id":"vulcan","base_url":"http://100.94.80.21:3939","model":"@preset/freyja-strong-local","capabilities":["general.large","reasoning"],"security_domain_id":"household","priority":12},{"endpoint_id":"vulcan-nexus-coder","display_name":"Vulcan Nexus coder preset","provider":"nexus","machine_id":"vulcan","base_url":"http://100.94.80.21:3939","model":"@preset/freyja-coder","capabilities":["code.large","coding"],"security_domain_id":"household","priority":12}]'
FREYJA3_INFERENCE_ENDPOINTS=

TOOLS_ENABLED=true
TOOLS_AUDIT_LOG_ENABLED=true
WEATHER_TOOL_ENABLED=false

CALENDAR_DEFAULT_PROVIDER=memory
APPLE_CALENDAR_ENABLED=false
APPLE_CALENDAR_BACKEND=macagent
APPLE_CALENDAR_DEFAULT_CALENDAR_NAME=iCloud::Family
APPLE_CALENDAR_CALENDAR_ALIASES=joe=iCloud::Family,beth=iCloud::Family,family=iCloud::Family
APPLE_CALENDAR_TIMEOUT_SECONDS=9.0

MACAGENT_ENABLED=false
MACAGENT_BASE_URL=http://100.115.228.56:8765
MACAGENT_TOKEN=

HOME_ASSISTANT_BASE_URL=
HOME_ASSISTANT_ACCESS_TOKEN=
HOME_ASSISTANT_TIMEOUT_SECONDS=10
