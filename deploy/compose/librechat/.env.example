# Parallel LibreChat deployment for Freyja pass-through tablet evaluation.
# Copy to .env and fill secrets locally. Do not commit .env.

UID=1000
GID=1000
LIBRECHAT_BIND_IP=0.0.0.0
PORT=3080
ADMIN_PANEL_PORT=3090
DOMAIN_CLIENT=http://localhost:3080
LIBRECHAT_IMAGE=registry.librechat.ai/danny-avila/librechat-dev:latest

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-random-hex
JWT_REFRESH_SECRET=replace-with-random-hex
CREDS_KEY=replace-with-32-byte-base64-or-random-secret
CREDS_IV=replace-with-16-byte-base64-or-random-secret
MEILI_MASTER_KEY=replace-with-random-secret
ADMIN_PANEL_SESSION_SECRET=replace-with-random-secret
POSTGRES_PASSWORD=replace-with-random-secret

# Login posture for local/LAN evaluation.
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true

# Vulcan Msty Nexus OpenAI-compatible endpoint. Prefer Nexus over direct Ollama.
NEXUS_OPENAI_BASE_URL=http://100.94.80.21:3939/v1
NEXUS_OPENAI_API_KEY=replace-with-local-nexus-token

# Freyja Core MCP backend. Keep this on LAN/Tailscale only.
# If LibreChat runs in Docker Desktop on Iris, host.docker.internal reaches the
# host-side MCP wrapper.
FREYJA_CORE_MCP_URL=http://host.docker.internal:8766/mcp
FREYJA_CORE_MCP_TOKEN=replace-with-random-secret

RAG_PORT=8000
