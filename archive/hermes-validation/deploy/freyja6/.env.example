# Freyja 6.0 validation stack. Copy to .env on Atlas and fill secrets there.

COMPOSE_PROJECT_NAME=freyja6

# Pin versions during validation. Do not use latest/main tags here.
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.89.0

# Build or install Hermes Agent on Atlas from the verified release, then tag the
# local runtime image with this immutable validation tag.
HERMES_AGENT_VERSION=v2026.9.14
HERMES_AGENT_IMAGE=hermes-agent-local:${HERMES_AGENT_VERSION}
HERMES_AGENT_SOURCE=/opt/hermes-agent

LITELLM_MASTER_KEY=replace-with-atlas-local-litellm-key
FREYJA6_LITELLM_BASE_URL=http://127.0.0.1:4600/v1
FREYJA6_CORE_URL=http://127.0.0.1:8510
FREYJA6_CORE_MCP_HEALTH_URL=http://127.0.0.1:8766/healthz
FREYJA6_TERMINAL_MCP_HEALTH_URL=http://127.0.0.1:8765/healthz
POSTGRES_PASSWORD=replace-with-freyja6-postgres-password
DATABASE_URL=postgresql://litellm:${POSTGRES_PASSWORD}@litellm-db:5432/litellm

# Vulcan is inference only. Prefer existing Ollama/vLLM/llama.cpp endpoints.
VULCAN_OLLAMA_BASE_URL=http://100.94.80.21:11434
VULCAN_FAST_MODEL=qwen2.5:7b
VULCAN_GENERAL_MODEL=qwen3.8:27b
VULCAN_CODE_MODEL=qwen3-coder-next:q4_K_M

# Dedicated Discord test channel only. Do not reuse existing Freyja bot tokens.
FREYJA6_DISCORD_BOT_TOKEN=
FREYJA6_DISCORD_CHANNEL_ID=

# Agent-specific MCP credentials. Do not reuse Freyja 4/5 tokens.
FREYJA6_CORE_MCP_TOKEN=
FREYJA6_TERMINAL_MCP_TOKEN=

FREYJA6_APPROVED_FILES_ROOT=/srv/freyja6/approved-files
FREYJA6_LOG_ROOT=/srv/freyja6/logs
FREYJA6_HERMES_DATA=/srv/freyja6/hermes
FREYJA6_APPROVED_SMOKE_FILE=/srv/freyja6/approved-files/smoke.txt
FREYJA6_CALENDAR_SMOKE_START=2026-09-19T00:00:00+00:00
FREYJA6_CALENDAR_SMOKE_END=2026-09-20T00:00:00+00:00
FREYJA6_HOME_SMOKE_DOMAIN=sensor

# Discord reply validation evidence. Use either API IDs or the manual trace pair.
FREYJA6_DISCORD_SMOKE_MESSAGE_ID=
FREYJA6_DISCORD_SMOKE_REPLY_ID=
FREYJA6_DISCORD_MESSAGE_TRACE_ID=
FREYJA6_DISCORD_REPLY_TRACE_ID=
FREYJA6_DISCORD_MANUAL_CONFIRMATION=

# Calendar write validation. The bundle only writes when --calendar-write is set.
FREYJA6_CALENDAR_WRITE_CALENDAR_ID=
FREYJA6_CALENDAR_WRITE_BASE_DATE=
FREYJA6_CALENDAR_WRITE_START_TIME=09:00:00

# Restart/reboot validation evidence. Fill only during the guarded live restart run.
FREYJA6_IDENTITY_SHA256_BEFORE=
FREYJA6_RESTORED_SESSION_ID=
FREYJA6_MEMORY_FACT_LABEL=freyja6-validation-basement-cleanup
FREYJA6_MEMORY_RECALL_TRACE_ID=
FREYJA6_CONTAINER_STATUS_AFTER=
FREYJA6_REBOOT_START=
FREYJA6_REBOOT_END=
FREYJA6_DISCORD_REPLY_AFTER_REBOOT_TRACE_ID=
FREYJA6_DISCORD_REPLY_AFTER_REBOOT_VERIFICATION=
